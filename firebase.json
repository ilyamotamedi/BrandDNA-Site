{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "test",
          "region": "us-central1"
        }
      }
    ]
  },
  "apphosting": {
    "backendId": "test",
    "rootDir": "/",
    "alwaysDeployFromSource": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
